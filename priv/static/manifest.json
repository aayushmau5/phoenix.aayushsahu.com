{
	"id": "/",
	"name": "phoenix.aayushsahu.com",
	"short_name": "Accumulator",
	"description": "Personal dashboard for notes, pastes, plants and photos.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#0c0c0c",
	"theme_color": "#0c0c0c",
	"launch_handler": {
		"client_mode": ["focus-existing", "auto"]
	},
	"icons": [
		{
			"src": "/apple-touch-icon.png",
			"sizes": "180x180",
			"type": "image/png"
		},
		{
			"src": "/android-chrome-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/android-chrome-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/maskable-icon-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Notes",
			"url": "/notes",
			"icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
		},
		{
			"name": "New paste",
			"short_name": "Bin",
			"url": "/bin/create",
			"icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
		},
		{
			"name": "Plants",
			"url": "/plants",
			"icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
		},
		{
			"name": "Photos",
			"url": "/photos",
			"icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
		}
	],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "photos",
					"accept": ["image/jpeg", "image/png", "image/webp", ".jpg", ".jpeg", ".png", ".webp"]
				}
			]
		}
	}
}
